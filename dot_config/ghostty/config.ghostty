shell-integration = zsh
theme = Catppuccin Mocha
scrollback-limit = 100000000

custom-shader = shaders/cursor_sweep.glsl

keybind=clear

keybind = super+c=copy_to_clipboard:mixed
keybind = super+v=paste_from_clipboard
keybind = super+f=start_search
keybind = super+shift+f=end_search
keybind = super+g=navigate_search:next
keybind = super+a=select_all


keybind = ctrl+b>r=reload_config

keybind = ctrl+b>v=new_split:right
keybind = ctrl+b>s=new_split:down
keybind = ctrl+b>m=toggle_split_zoom

keybind = ctrl+b>h=goto_split:left
keybind = ctrl+b>j=goto_split:down
keybind = ctrl+b>k=goto_split:up
keybind = ctrl+b>l=goto_split:right

keybind = ctrl+b>x=close_surface

keybind = ctrl+b>c=new_tab
keybind = ctrl+b>n=next_tab
keybind = ctrl+b>p=previous_tab

keybind = ctrl+b>1=goto_tab:1
keybind = ctrl+b>2=goto_tab:2
keybind = ctrl+b>3=goto_tab:3
keybind = ctrl+b>4=goto_tab:4
keybind = ctrl+b>5=goto_tab:5
keybind = ctrl+b>6=goto_tab:6
keybind = ctrl+b>7=goto_tab:7
keybind = ctrl+b>8=goto_tab:8
keybind = ctrl+b>9=goto_tab:9

keybind = global:cmd+backquote=toggle_quick_terminal

keybind = ctrl+b>w>f=write_scrollback_file:open
keybind = ctrl+b>w>c=write_scrollback_file:copy



